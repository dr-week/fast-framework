{
  "name": "@zuari/presets",
  "version": "0.1.0",
  "description": "Modular Japanese Minimal & Anime-Artistic UI/UX Design, Lightweight Elevations, and Keyframe Animation Presets for Zuari",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@zuari/signals": "workspace:*",
    "@zuari/tokens": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
