{
  "name": "@zuari/headless",
  "version": "0.1.0",
  "description": "Zero-style, accessible UI primitives powered by TC39 Signals and native browser Anchor Positioning",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zuari/signals": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.ts",
      "import": "./dist/combobox/index.js"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "import": "./dist/command/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "import": "./dist/drawer/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual/index.d.ts",
      "import": "./dist/virtual/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
