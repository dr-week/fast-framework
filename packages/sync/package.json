{
  "name": "@zuari/sync",
  "version": "0.1.0",
  "description": "Local-First CRDT & Cross-Tab/Edge Sync Signals for Zuari (OPFS, IndexedDB, BroadcastChannel, Binary CRDT Deltas)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@zuari/signals": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
