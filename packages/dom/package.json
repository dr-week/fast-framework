{
  "name": "@zuari/dom",
  "version": "0.1.0",
  "description": "Zero-VDOM direct-to-DOM template compiler powered by HTMLTemplateElement and fine-grained signals",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@zuari/signals": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
