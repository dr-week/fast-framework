{
  "name": "@zuari/glyphs",
  "version": "0.1.0",
  "description": "Tree-shakeable SVG glyphs with optional Lucide icon adapters",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lucide": {
      "types": "./dist/lucide.d.ts",
      "import": "./dist/lucide.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "lucide": "1.70.0"
  }
}
