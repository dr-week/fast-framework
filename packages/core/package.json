{
  "name": "@zuari/core",
  "version": "0.1.0",
  "description": "Unified entry point for Zuari - Ultra-lightweight, platform-first web UI/UX framework",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@zuari/signals": "workspace:*",
    "@zuari/dom": "workspace:*",
    "@zuari/tokens": "workspace:*",
    "@zuari/glyphs": "workspace:*",
    "@zuari/headless": "workspace:*",
    "@zuari/recipes": "workspace:*",
    "@zuari/ui": "workspace:*",
    "@zuari/wasm": "workspace:*",
    "@zuari/spatial": "workspace:*",
    "@zuari/webgpu": "workspace:*",
    "@zuari/sync": "workspace:*",
    "@zuari/ai": "workspace:*",
    "@zuari/router": "workspace:*",
    "@zuari/wit": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "types": "../signals/dist/index.d.ts",
      "import": "../signals/dist/index.js"
    },
    "./dom": {
      "types": "../dom/dist/index.d.ts",
      "import": "../dom/dist/index.js"
    },
    "./tokens": {
      "types": "../tokens/dist/index.d.ts",
      "import": "../tokens/dist/index.js"
    },
    "./glyphs": {
      "types": "../glyphs/dist/index.d.ts",
      "import": "../glyphs/dist/index.js"
    },
    "./headless": {
      "types": "../headless/dist/index.d.ts",
      "import": "../headless/dist/index.js"
    },
    "./ui": {
      "types": "../ui/dist/index.d.ts",
      "import": "../ui/dist/index.js"
    },
    "./wasm": {
      "types": "../wasm/dist/index.d.ts",
      "import": "../wasm/dist/index.js"
    },
    "./spatial": {
      "types": "../spatial/dist/index.d.ts",
      "import": "../spatial/dist/index.js"
    },
    "./webgpu": {
      "types": "../webgpu/dist/index.d.ts",
      "import": "../webgpu/dist/index.js"
    },
    "./sync": {
      "types": "../sync/dist/index.d.ts",
      "import": "../sync/dist/index.js"
    },
    "./ai": {
      "types": "../ai/dist/index.d.ts",
      "import": "../ai/dist/index.js"
    },
    "./router": {
      "types": "../router/dist/index.d.ts",
      "import": "../router/dist/index.js"
    },
    "./wit": {
      "types": "../wit/dist/index.d.ts",
      "import": "../wit/dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}

